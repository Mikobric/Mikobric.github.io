---
const tickerItems = ["LET'S TALK", "LET'S TALK", "LET'S TALK", "LET'S TALK"];
---

<footer class="footer" id="contact">
  <div class="footer__ticker">
    <div class="marquee" style="--marquee-duration: 14s">
      {
        [0, 1].map(() => (
          <div class="marquee__strip display" aria-hidden="true">
            {tickerItems.map((item) => (
              <>
                <span>{item}</span>
                <span class="footer__sep">✦</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap">
    <h2 class="display footer__headline" data-reveal>
      <span class="glitch" data-text="GET IN">GET IN</span><br />
      <span class="glitch" data-text="TOUCH">TOUCH</span><span class="footer__arrow">↗</span>
    </h2>

    <div class="terminal" data-reveal>
      <div class="terminal__row">
        <span class="label">COMMS LINK //</span>
        <a class="terminal__value" href="mailto:byniutek@gmail.com">BYNIUTEK@GMAIL.COM</a>
      </div>
      <div class="terminal__row">
        <span class="label">SOURCE //</span>
        <a class="terminal__value" href="https://github.com/Mikobric" target="_blank" rel="noopener">
          GITHUB.COM/MIKOBRIC
        </a>
      </div>
      <div class="terminal__row">
        <span class="label">STATUS //</span>
        <span class="terminal__value">OPEN FOR WORK</span>
      </div>
      <a class="terminal__cta pressable" href="mailto:byniutek@gmail.com">TRANSMIT&nbsp;&nbsp;↗</a>
    </div>

    <div class="footer__bottom">
      <span class="label">© 2026 MIKO</span>
      <span class="label">ASTRO + CSS</span>
      <span class="label">MADE IN PL</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: 120px;
    padding-bottom: 32px;
  }

  .footer__ticker {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 14px 0;
    overflow: hidden;
  }

  .footer__ticker .marquee__strip {
    font-size: 26px;
    color: var(--accent);
  }

  .footer__sep {
    font-size: 0.5em;
    align-self: center;
    color: var(--accent);
  }

  .footer__headline {
    font-size: clamp(80px, 16vw, 200px);
    margin: 48px 0 36px;
  }

  .footer__arrow {
    color: var(--accent);
    -webkit-text-stroke: 0;
  }

  .terminal {
    border: 1px solid var(--hairline);
    max-width: 640px;
  }

  .terminal__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border-bottom: 1px solid var(--hairline);
  }

  .terminal__value {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  a.terminal__value:hover {
    color: var(--accent);
  }

  .terminal__cta {
    display: block;
    text-align: center;
    background: var(--accent);
    color: #000;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.25em;
    padding: 16px;
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .terminal__cta:hover {
    background: var(--ink);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
  }
</style>
