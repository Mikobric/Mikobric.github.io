---
const toc = [
  { no: '1.0', label: 'GENERAL DESCRIPTION', page: '01', href: '#description' },
  { no: '2.0', label: 'SELECTED WORKS', page: '02', href: '#works' },
  { no: '3.0', label: 'ELECTRICAL CHARACTERISTICS', page: '03', href: '#characteristics' },
  { no: '4.0', label: 'ORDERING INFORMATION', page: '04', href: '#ordering' },
];
---

<section class="hero wrap">
  <h1 class="hero__headline display">
    <span class="hero__word wipe">HARDWARE</span>
    <span class="hero__word hero__word--right wipe" style="--wipe-delay: 0.25s">
      MAKER<span class="stamp stamp--accent stamp--rotated stamp--thump hero__stamp">OPEN FOR WORK</span>
    </span>
  </h1>

  <div class="hero__sub" data-reveal style="--reveal-delay: 0.2s">
    <p class="hero__quote">
      Solar weather stations, RF pager networks, sensor experiments — and the software around
      them.
    </p>
    <span class="chip"><span class="chip__dot"></span>SYS. ACTIVE</span>
  </div>

  <div class="hero__toc" data-reveal style="--reveal-delay: 0.3s">
    <span class="label hero__toc-label">INDEX</span>
    <nav class="hero__toc-list">
      {
        toc.map((item) => (
          <a class="hero__toc-row" href={item.href}>
            <span class="hero__toc-no label--accent">{item.no}</span>
            <span class="hero__toc-name" data-scramble>{item.label}</span>
            <span class="hero__toc-dots" aria-hidden="true" />
            <span class="hero__toc-page">{item.page}</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    font-size: clamp(72px, 14.5vw, 215px);
  }

  .hero__word--right {
    align-self: flex-end;
    position: relative;
  }

  .hero__stamp {
    position: absolute;
    top: -8px;
    right: -14px;
    font-size: clamp(9px, 1vw, 13px);
  }

  .hero__sub {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-top: 40px;
  }

  .hero__quote {
    max-width: 520px;
    border-left: 2px solid var(--rule);
    padding: 10px 0 10px 20px;
    background: var(--paper-dim);
    padding-right: 20px;
    font-size: 14px;
  }

  .hero__toc {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 900px) {
    .hero__toc {
      grid-template-columns: 180px 1fr;
    }
  }

  .hero__toc-label {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 6px;
    align-self: start;
    width: fit-content;
  }

  .hero__toc-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    font-family: var(--font-mono);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__toc-row:hover .hero__toc-name {
    color: var(--accent);
  }

  .hero__toc-dots {
    flex: 1;
    border-bottom: 1px dotted var(--rule-soft);
    transform: translateY(-3px);
  }

  .hero__toc-page {
    font-weight: 700;
  }
</style>
