---
const inkItems = ['HARDWARE', 'FIRMWARE', 'DESIGN', 'RADIO'];
const accentItems = ['ESP32', 'LORA', 'ASTRO', 'SWIFTUI', 'METAL', 'C++'];
---

<div class="band">
  <div class="marquee band__ink" style="--marquee-duration: 22s">
    {
      [0, 1].map(() => (
        <div class="marquee__strip display" aria-hidden="true">
          {inkItems.map((item) => (
            <>
              <span>{item}</span>
              <span class="band__sep">✦</span>
            </>
          ))}
        </div>
      ))
    }
  </div>

  <div class="band__accent">
    <div class="marquee marquee--reverse" style="--marquee-duration: 16s">
      {
        [0, 1].map(() => (
          <div class="marquee__strip display" aria-hidden="true">
            {accentItems.map((item) => (
              <>
                <span>{item}</span>
                <span class="band__sep">✦</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .band {
    padding: 56px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow: hidden;
  }

  .band__ink .marquee__strip {
    font-size: 38px;
    color: var(--ink);
    opacity: 0.9;
  }

  .band__accent {
    background: var(--accent);
    transform: rotate(-1.6deg) scale(1.06);
    padding: 10px 0;
  }

  .band__accent .marquee__strip {
    font-size: 22px;
    color: #000;
  }

  .band__sep {
    font-size: 0.45em;
    align-self: center;
  }
</style>
