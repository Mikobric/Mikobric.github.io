---
import { projects } from '../data/projects';

function stampClass(status: string): string {
  return status === 'LIVE' ? 'stamp stamp--accent' : 'stamp';
}
---

<section class="section wrap" id="works">
  <div class="watermark" aria-hidden="true"><span>CONFIDENTIAL</span></div>

  <div class="sec-head" data-reveal>
    <span class="sec-head__no">2.0</span>
    <span class="sec-head__title">SELECTED WORKS</span>
    <span class="sec-head__meta label">PAGE 02</span>
  </div>

  <div class="registry" role="table">
    {
      projects.map((project, i) => (
        <a
          class="row pressy"
          href={`/works/${project.id}/`}
          data-reveal
          data-touch-hot
          style={`--reveal-delay: ${i * 0.06}s`}
        >
          <span class="row__index">{project.index}</span>
          <span class="row__name-block">
            <span class="row__name display">{project.title}</span>
            <span class="row__subtitle">{project.subtitle}</span>
          </span>
          <span class="row__year">{project.year}</span>
          <span class={stampClass(project.status)}>{project.status}</span>
          <span class="row__arrow" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>

  <p class="fig label" data-reveal>FIG. 01 — PROJECT INDEX / REGISTRY</p>
</section>

<style>
  .registry {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 36px 1fr auto auto;
    align-items: center;
    gap: 14px;
    padding: 20px 10px;
    border-bottom: 1px solid var(--rule-soft);
    transition: background 0.25s, color 0.25s;
  }

  @media (min-width: 760px) {
    .row {
      grid-template-columns: 56px 1fr 110px 130px 40px;
      gap: 20px;
      padding: 22px 14px;
    }
  }

  .row__index {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
  }

  .row__name-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .row__name {
    font-size: clamp(36px, 7vw, 76px);
    line-height: 1;
  }

  .row__subtitle {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .row__year {
    display: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 760px) {
    .row__year {
      display: block;
    }
  }

  .row__arrow {
    display: none;
    font-size: 18px;
    font-weight: 700;
    transition: transform 0.25s;
  }

  @media (min-width: 760px) {
    .row__arrow {
      display: block;
    }
  }

  /* Hover (desktop) / scroll-center (touch): the row inverts to ink, paper text */
  .row:hover,
  .row.touch-hot {
    background: var(--ink);
    color: var(--paper);
  }

  .row:hover .row__subtitle,
  .row.touch-hot .row__subtitle {
    color: rgba(251, 249, 243, 0.6);
  }

  .row:hover .row__arrow,
  .row.touch-hot .row__arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  .row:hover .stamp:not(.stamp--accent),
  .row.touch-hot .stamp:not(.stamp--accent) {
    color: var(--paper);
  }

  .row.touch-hot .row__index {
    color: var(--accent);
  }

  .fig {
    margin-top: 14px;
  }
</style>
