---
const stats = [
  { label: 'PROTOTYPES BUILT', value: 24, suffix: '+' },
  { label: 'SENSORS TAMED', value: 9, suffix: '' },
  { label: 'M LORA RANGE', value: 1800, suffix: '+' },
  { label: 'SOLDER JOINTS', value: 9999, suffix: '+' },
];

const capabilities = [
  'HARDWARE DESIGN',
  'FIRMWARE / C++',
  'RF & PROTOCOLS',
  'APPS / SWIFTUI',
  'RAPID PROTOTYPING',
];
---

<section class="about wrap" id="about">
  <p class="label label--accent glow" data-reveal>ABOUT</p>

  <h2 class="display about__statement" data-reveal>
    I MAKE<br /><mark>HARDWARE</mark><br />TALK.
  </h2>

  <p class="about__body" data-reveal>
    Self-taught maker from Poland. I design, solder and ship connected devices — solar weather
    stations, RF pager networks, sensor experiments — and the software around them, from C++
    firmware to SwiftUI apps.
  </p>

  <div class="about__stats" data-reveal>
    {
      stats.map((stat) => (
        <div class="about__cell">
          <span class="display about__num" data-count={stat.value} data-suffix={stat.suffix}>
            0
          </span>
          <span class="label">{stat.label}</span>
        </div>
      ))
    }
  </div>

  <div class="about__caps">
    <p class="label label--accent glow" data-reveal>CAPABILITIES</p>
    {
      capabilities.map((cap, i) => (
        <div class="about__cap" data-reveal="right" style={`--reveal-delay: ${i * 0.08}s`}>
          <span class="about__cap-index label">{String(i + 1).padStart(2, '0')}</span>
          <span class="about__cap-name">{cap}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .about {
    padding-top: 120px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about__statement {
    font-size: clamp(64px, 11vw, 130px);
  }

  .about__body {
    max-width: 560px;
    color: var(--muted);
    font-size: 16px;
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--hairline);
    border-radius: 20px;
    overflow: hidden;
    background: var(--hairline);
  }

  @media (min-width: 900px) {
    .about__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .about__cell {
    background: #131316;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about__num {
    font-size: clamp(40px, 6vw, 64px);
  }

  .about__caps {
    margin-top: 24px;
  }

  .about__caps > .label {
    display: block;
    margin-bottom: 14px;
  }

  .about__cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-top: 1px solid var(--hairline);
  }

  .about__cap-index {
    color: var(--accent);
  }

  .about__cap-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
</style>
