---
/* LAB — network map prototype. Standalone page (no Base layout): the film
   engine stays out, the constellation can be tuned in isolation. */
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0d0b" />
    <title>LAB — NETWORK MAP</title>
  </head>
  <body>
    <main>
      <canvas id="mesh" aria-hidden="true"></canvas>

      <header class="hud">
        <strong>MIKO LAB — NETWORK MAP</strong>
        <span>[SCROLL / &larr;&rarr;] FLY THE STORY · [CLICK NODE] TUNE IN · [DRAG NODE] STRETCH · [H] PANEL</span>
      </header>

      <footer class="hud readout">
        <span id="cam-readout">CAM 0000,0000 &times;1.00</span>
        <span id="node-readout">LINK &mdash;</span>
      </footer>

      <aside id="panel"></aside>
    </main>

    <script src="../scripts/lab-mesh.ts"></script>

    <style is:global>
      /* global on purpose: panel rows are built by lab-mesh.ts */
      :root {
        --bg: #0b0d0b;
        --ink: #e6f2e6;
        --dim: #7c8a7c;
        --green: #33ff66;
        --amber: #ffb000;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
        overflow: hidden;
        overscroll-behavior: none;
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        -webkit-font-smoothing: antialiased;
        cursor: crosshair;
      }

      main {
        position: fixed;
        inset: 0;
      }

      #mesh {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .hud {
        position: absolute;
        left: 20px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        letter-spacing: 0.08em;
        z-index: 2;
        pointer-events: none;
      }

      .hud strong {
        color: var(--ink);
        font-weight: 700;
      }

      .hud span {
        color: var(--dim);
      }

      header.hud {
        top: 20px;
      }

      footer.readout {
        bottom: 20px;
      }

      footer.readout #node-readout {
        color: var(--green);
      }

      #panel {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 230px;
        padding: 12px 14px;
        background: rgba(11, 13, 11, 0.85);
        border: 1px solid rgba(230, 242, 230, 0.14);
        z-index: 2;
      }

      #panel.hidden {
        display: none;
      }

      #panel .row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2px 8px;
        margin-bottom: 8px;
      }

      #panel .row label {
        color: var(--dim);
        letter-spacing: 0.08em;
      }

      #panel .row output {
        color: var(--green);
        text-align: right;
      }

      #panel .row input[type='range'] {
        grid-column: 1 / -1;
        width: 100%;
        accent-color: #33ff66;
      }

      #panel .btns {
        display: flex;
        gap: 6px;
        margin-top: 4px;
      }

      #panel .btns button {
        flex: 1;
        font: inherit;
        letter-spacing: 0.08em;
        color: var(--dim);
        background: none;
        border: 1px solid rgba(230, 242, 230, 0.14);
        padding: 4px 0;
        cursor: pointer;
      }

      #panel .fps {
        color: var(--dim);
        text-align: right;
        margin-bottom: 8px;
      }
    </style>
  </body>
</html>
