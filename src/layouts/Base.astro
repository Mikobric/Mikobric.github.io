---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  docNo?: string;
  sheet?: string;
}

const {
  title = 'MIKO® — HARDWARE SYSTEMS',
  description = 'Hardware maker portfolio: solar weather stations, RF pager networks, sensor experiments — and the software around them.',
  docNo = 'MIKO-2026',
  sheet = 'SHEET 1 OF 1',
} = Astro.props;

const nav = [
  { no: '1.0', label: 'DESCRIPTION', href: '/#description' },
  { no: '2.0', label: 'WORKS', href: '/#works' },
  { no: '3.0', label: 'CHARACTERISTICS', href: '/#characteristics' },
  { no: '4.0', label: 'ORDERING', href: '/#ordering' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fbf9f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;700&family=JetBrains+Mono:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <span class="regmark regmark--tl" aria-hidden="true"></span>
    <span class="regmark regmark--tr" aria-hidden="true"></span>
    <span class="regmark regmark--bl" aria-hidden="true"></span>
    <span class="regmark regmark--br" aria-hidden="true"></span>

    <div class="follower" aria-hidden="true"></div>

    <div class="doc-strip">
      <span class="doc-strip__brand">MIKO®</span>
      <span class="doc-strip__clock" id="doc-clock" aria-hidden="true"></span>
      <span class="doc-strip__meta">
        DOC NO. {docNo}<span class="doc-strip__extra">&nbsp;&nbsp;|&nbsp;&nbsp;REV. A&nbsp;&nbsp;|&nbsp;&nbsp;{sheet}</span>
      </span>
    </div>

    <header class="masthead">
      <a href="/" class="masthead__brand display">
        MIKO <span class="masthead__sep">//</span> HARDWARE SYSTEMS
        <span class="masthead__square" aria-hidden="true"></span>
      </a>
      <nav class="masthead__nav">
        {
          nav.map((item) => (
            <a href={item.href} class="masthead__link label">
              <span class="label--accent">{item.no}</span> <span data-scramble>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <a class="masthead__cta" href="mailto:byniutek@gmail.com">ORDER.SYS</a>
      <span class="masthead__progress" id="read-progress" aria-hidden="true"></span>
    </header>

    <slot />

    <footer class="doc-footer">
      <span>COPYRIGHT © 2026 MIKO MFG. ALL RIGHTS RESERVED.</span>
      <span class="doc-footer__mid">END OF DOCUMENT</span>
      <span>MADE IN PL&nbsp;&nbsp;|&nbsp;&nbsp;PRNT. DEPT.</span>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const counterIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            counterIo.unobserve(el);
            const target = Number(el.dataset.count ?? '0');
            const suffix = el.dataset.suffix ?? '';
            const start = performance.now();
            const duration = 1200;
            const tick = (now: number) => {
              const t = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.6 }
      );
      document.querySelectorAll('[data-count]').forEach((el) => counterIo.observe(el));

      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Trailing square follower — native cursor stays visible.
      const follower = document.querySelector<HTMLElement>('.follower');
      if (follower && fine) {
        let mx = -50, my = -50, fx = -50, fy = -50;
        let hot = false;
        addEventListener('mousemove', (e) => {
          mx = e.clientX + 14;
          my = e.clientY + 14;
        });
        const loop = () => {
          fx += (mx - fx) * 0.16;
          fy += (my - fy) * 0.16;
          const spin = hot ? ' rotate(45deg) scale(1.5)' : '';
          follower.style.transform = `translate(${fx}px, ${fy}px)${spin}`;
          requestAnimationFrame(loop);
        };
        loop();
        document.querySelectorAll('a, button').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            hot = true;
            follower.classList.add('follower--link');
          });
          el.addEventListener('mouseleave', () => {
            hot = false;
            follower.classList.remove('follower--link');
          });
        });
      }

      // Touch devices have no hover — light up the row nearest viewport center
      // while scrolling, so the page feels alive on the phone too.
      if (matchMedia('(hover: none)').matches) {
        const hotIo = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('touch-hot', entry.isIntersecting);
            }
          },
          { rootMargin: '-45% 0px -45% 0px' }
        );
        document
          .querySelectorAll('[data-touch-hot]')
          .forEach((el) => hotIo.observe(el));
      }

      // Gentle hero parallax.
      if (!calm) {
        const words = document.querySelectorAll<HTMLElement>('.hero__word');
        if (words.length) {
          let ticking = false;
          addEventListener(
            'scroll',
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                words.forEach((word, i) => {
                  word.style.transform = `translateY(${scrollY * (i === 0 ? -0.06 : -0.14)}px)`;
                });
                ticking = false;
              });
            },
            { passive: true }
          );
        }
      }

      // Live clock in the document strip.
      const clock = document.getElementById('doc-clock');
      if (clock) {
        const tick = () => {
          const now = new Date();
          clock.textContent = `T ${now.toTimeString().slice(0, 8)} LOCAL`;
        };
        tick();
        setInterval(tick, 1000);
      }

      // Reading progress under the masthead.
      const progress = document.getElementById('read-progress');
      if (progress) {
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          progress.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        };
        addEventListener('scroll', update, { passive: true });
        update();
      }

      // Text scramble on hover for [data-scramble].
      if (fine && !calm) {
        const GLYPHS = '▓▒░<>/=+#*0123456789';
        document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
          const original = el.textContent ?? '';
          let frame = 0;
          let raf = 0;
          const run = () => {
            frame++;
            const reveal = Math.floor(frame / 2);
            el.textContent = original
              .split('')
              .map((ch, i) =>
                ch === ' ' || i < reveal
                  ? ch
                  : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]
              )
              .join('');
            if (reveal < original.length) raf = requestAnimationFrame(run);
            else el.textContent = original;
          };
          el.closest('a, button, [data-scramble-host]')?.addEventListener('mouseenter', () => {
            cancelAnimationFrame(raf);
            frame = 0;
            run();
          });
        });
      }
    </script>

    <style>
      .doc-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px var(--gutter);
        border-bottom: 1px solid var(--rule-soft);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--ink-soft);
        text-transform: uppercase;
      }

      .doc-strip__brand {
        font-weight: 800;
        color: var(--ink);
      }

      .doc-strip__meta {
        white-space: nowrap;
      }

      .doc-strip__extra {
        display: none;
      }

      @media (min-width: 640px) {
        .doc-strip__extra {
          display: inline;
        }
      }

      .doc-strip__clock {
        display: none;
        font-variant-numeric: tabular-nums;
      }

      @media (min-width: 900px) {
        .doc-strip__clock {
          display: inline;
        }
      }

      .masthead {
        position: sticky;
        top: 0;
        z-index: 90;
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 14px var(--gutter);
        background: var(--paper);
        border-bottom: 2px solid var(--rule);
      }

      .masthead__progress {
        position: absolute;
        left: 0;
        bottom: -2px;
        height: 2px;
        width: 0%;
        background: var(--accent);
        z-index: 1;
      }

      .masthead__brand {
        font-size: 19px;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .masthead__sep {
        color: var(--accent);
      }

      .masthead__square {
        display: inline-block;
        width: 9px;
        height: 9px;
        background: var(--accent);
        margin-left: 2px;
      }

      .masthead__nav {
        display: none;
        gap: 22px;
        margin-left: auto;
      }

      @media (min-width: 900px) {
        .masthead__nav {
          display: flex;
        }
      }

      .masthead__link {
        color: var(--ink);
        transition: color 0.2s;
      }

      .masthead__link:hover {
        color: var(--accent);
      }

      .masthead__cta {
        margin-left: auto;
        background: var(--accent);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.18em;
        padding: 10px 16px;
        transition: background 0.2s;
      }

      @media (min-width: 900px) {
        .masthead__cta {
          margin-left: 0;
        }
      }

      .masthead__cta:hover {
        background: var(--ink);
      }

      .doc-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: space-between;
        margin-top: 110px;
        padding: 16px var(--gutter) 26px;
        border-top: 2px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .doc-footer__mid {
        font-weight: 700;
        color: var(--ink);
      }
    </style>
  </body>
</html>
