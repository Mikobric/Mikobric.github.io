---
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MIKO® — Hardware Maker, On Air',
  description = 'Solar weather stations, RF pager networks, sensor experiments — and the software around them. Transmitting from Poland.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0d0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <canvas id="trail" aria-hidden="true"></canvas>
    <div id="cursor" aria-hidden="true">
      <span class="c-ring"></span>
      <span class="c-frame">
        <i class="c-corner c-tl"></i>
        <i class="c-corner c-tr"></i>
        <i class="c-corner c-br"></i>
        <i class="c-corner c-bl"></i>
      </span>
      <span class="c-dot"></span>
    </div>
    <script src="../scripts/main.ts"></script>
    <script src="../scripts/ascii-logo.ts"></script>
  </body>
</html>
