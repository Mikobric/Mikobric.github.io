---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  docNo?: string;
  sheet?: string;
}

const {
  title = 'MIKO® — HARDWARE SYSTEMS',
  description = 'Hardware maker portfolio: solar weather stations, RF pager networks, sensor experiments — and the software around them.',
  docNo = 'MIKO-2026',
  sheet = 'SHEET 1 OF 1',
} = Astro.props;

const nav = [
  { no: '1.0', label: 'DESCRIPTION', href: '/#description' },
  { no: '2.0', label: 'WORKS', href: '/#works' },
  { no: '3.0', label: 'CHARACTERISTICS', href: '/#characteristics' },
  { no: '4.0', label: 'ORDERING', href: '/#ordering' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fbf9f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;700&family=JetBrains+Mono:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <span class="regmark regmark--tl" aria-hidden="true"></span>
    <span class="regmark regmark--tr" aria-hidden="true"></span>
    <span class="regmark regmark--bl" aria-hidden="true"></span>
    <span class="regmark regmark--br" aria-hidden="true"></span>

    <div class="doc-strip">
      <span class="doc-strip__brand">MIKO®</span>
      <span class="doc-strip__meta">
        DOC NO. {docNo}<span class="doc-strip__extra">&nbsp;&nbsp;|&nbsp;&nbsp;REV. A&nbsp;&nbsp;|&nbsp;&nbsp;{sheet}</span>
      </span>
    </div>

    <header class="masthead">
      <a href="/" class="masthead__brand display">
        MIKO <span class="masthead__sep">//</span> HARDWARE SYSTEMS
        <span class="masthead__square" aria-hidden="true"></span>
      </a>
      <nav class="masthead__nav">
        {
          nav.map((item) => (
            <a href={item.href} class="masthead__link label">
              <span class="label--accent">{item.no}</span> {item.label}
            </a>
          ))
        }
      </nav>
      <a class="masthead__cta" href="mailto:byniutek@gmail.com">ORDER.SYS</a>
    </header>

    <slot />

    <footer class="doc-footer">
      <span>COPYRIGHT © 2026 MIKO MFG. ALL RIGHTS RESERVED.</span>
      <span class="doc-footer__mid">END OF DOCUMENT</span>
      <span>MADE IN PL&nbsp;&nbsp;|&nbsp;&nbsp;PRNT. DEPT.</span>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const counterIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            counterIo.unobserve(el);
            const target = Number(el.dataset.count ?? '0');
            const suffix = el.dataset.suffix ?? '';
            const start = performance.now();
            const duration = 1200;
            const tick = (now: number) => {
              const t = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.6 }
      );
      document.querySelectorAll('[data-count]').forEach((el) => counterIo.observe(el));
    </script>

    <style>
      .doc-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px var(--gutter);
        border-bottom: 1px solid var(--rule-soft);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--ink-soft);
        text-transform: uppercase;
      }

      .doc-strip__brand {
        font-weight: 800;
        color: var(--ink);
      }

      .doc-strip__meta {
        white-space: nowrap;
      }

      .doc-strip__extra {
        display: none;
      }

      @media (min-width: 640px) {
        .doc-strip__extra {
          display: inline;
        }
      }

      .masthead {
        position: sticky;
        top: 0;
        z-index: 90;
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 14px var(--gutter);
        background: var(--paper);
        border-bottom: 2px solid var(--rule);
      }

      .masthead__brand {
        font-size: 19px;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .masthead__sep {
        color: var(--accent);
      }

      .masthead__square {
        display: inline-block;
        width: 9px;
        height: 9px;
        background: var(--accent);
        margin-left: 2px;
      }

      .masthead__nav {
        display: none;
        gap: 22px;
        margin-left: auto;
      }

      @media (min-width: 900px) {
        .masthead__nav {
          display: flex;
        }
      }

      .masthead__link {
        color: var(--ink);
        transition: color 0.2s;
      }

      .masthead__link:hover {
        color: var(--accent);
      }

      .masthead__cta {
        margin-left: auto;
        background: var(--accent);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.18em;
        padding: 10px 16px;
        transition: background 0.2s;
      }

      @media (min-width: 900px) {
        .masthead__cta {
          margin-left: 0;
        }
      }

      .masthead__cta:hover {
        background: var(--ink);
      }

      .doc-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: space-between;
        margin-top: 110px;
        padding: 16px var(--gutter) 26px;
        border-top: 2px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .doc-footer__mid {
        font-weight: 700;
        color: var(--ink);
      }
    </style>
  </body>
</html>
